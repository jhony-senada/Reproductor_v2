<Application x:Class="Reproductor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- COLORES BASE (Para que el diseñador no marque error) -->
        <SolidColorBrush x:Key="ColorBarraSuperior" Color="#2b2b2b"/>
        <SolidColorBrush x:Key="ColorFondoPrincipal" Color="Black"/>
        <SolidColorBrush x:Key="ColorFondoSecundario" Color="#111111"/>
        <SolidColorBrush x:Key="ColorControles" Color="#660000"/>
        <SolidColorBrush x:Key="ColorAcentoTexto" Color="Red"/>
        <SolidColorBrush x:Key="ColorBtnCerrar" Color="DarkRed"/>
        <SolidColorBrush x:Key="ColorBtnMinimizar" Color="#444444"/>
        <SolidColorBrush x:Key="ColorLetras" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Barras" Color="#E65E39"/>
        <SolidColorBrush x:Key="ColorOscilo" Color="Red"/>
        <SolidColorBrush x:Key="ColorKaraoke" Color="Yellow"/>
        
        <FontFamily x:Key="FuentePrincipal">Segoe UI</FontFamily>
        <FontFamily x:Key="FuenteLetra">Segoe UI</FontFamily>

        <!-- ESTILO BÁSICO PARA LOS BOTONES DE LA BARRA -->
        <Style x:Key="EstiloBotonBarra" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>