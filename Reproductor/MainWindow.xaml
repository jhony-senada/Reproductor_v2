<Window x:Class="Reproductor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FuentePrincipal}"
        TextElement.FontFamily="{DynamicResource FuentePrincipal}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="Reproductor V1" Height="400" Width="500">
    <Grid>
        <Grid x:Name="Principal">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource ColorBarraSuperior}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Label Content="Reproductor V2" FontSize="25" Foreground="White"/>
                </Grid>
                <StackPanel x:Name="Menu_Funciones_pest" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="_" FontSize="30" Background="{DynamicResource ColorBtnMinimizar}" Click="BtnMii_Click" Width="50"/>
                    <Button Content="X" FontSize="30" Background="{DynamicResource ColorBtnCerrar}" Click="BtnClose_Click" Width="50"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row ="1" x:Name="Ventana_Principal" Background="{DynamicResource ColorFondoPrincipal}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="183*"/>
                    <ColumnDefinition Width="17*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <TabControl Grid.Row="0" Background="{DynamicResource ColorFondoPrincipal}" BorderThickness="0" Foreground="Black" Grid.ColumnSpan="2">
                    <TabItem Header="Now Playing" IsSelected="True">
                        <Grid Background="{DynamicResource ColorFondoPrincipal}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Canvas x:Name="CanvasVisualizador" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="CanvasVisualizador_MouseLeftButtonDown" Cursor="Hand"/>
                                <TextBlock x:Name="TextoLetras" Foreground="{DynamicResource ColorLetras}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="50,0,50,5" TextAlignment="Center" TextWrapping="Wrap" Grid.Column="1" FontFamily="{DynamicResource FuenteLetra}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TextoTiempoActual" Grid.Column="0" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider x:Name="SliderProgreso" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonDown="SliderProgreso_MouseDown" PreviewMouseLeftButtonUp="SliderProgreso_MouseUp" ValueChanged="SliderProgreso_ValueChanged"/>
                                <TextBlock x:Name="TextoTiempoTotal" Grid.Column="2" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Library">
                        <Grid Background="{DynamicResource ColorFondoSecundario}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0">
                                <TextBlock Text="Playlist Actual:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ComboPlaylists" Width="150" Background="#222222" Foreground="Black" BorderThickness="0" SelectionChanged="ComboPlaylists_SelectionChanged" Cursor="Hand"/>
                                <Button Content="💾 Guardar Como..." Width="100" Height="22" Margin="10,0,0,0" Background="#444444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnGuardarComoPlaylist_Click"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,5">
                                <Button Content="+ Añadir Música" Width="120" Height="25" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAgregarCancion_Click" Margin="0,0,10,5"/>
                                <Button Content="🗑 Eliminar" Width="100" Height="25" Background="DarkRed" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnEliminarCancion_Click" Margin="0,0,10,5"/>
                                <Button Content="🎤 LRC Maker" Width="100" Height="25" Background="#551a8b" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAbrirLRCMaker_Click" Margin="0,0,10,5"/>
                            </WrapPanel>
                            <ListBox x:Name="ListaVisualCanciones" Grid.Row="2" Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0,10,10" SelectionChanged="ListaVisualCanciones_SelectionChanged"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Skins">
                        <Grid Background="{DynamicResource ColorFondoSecundario}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="SELECCIONA UN TEMA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <ListBox x:Name="ListaSkins" Width="200" Height="100" Background="#222222" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                                <Button Content="+ Crear Tema Nuevo" Width="120" Height="25" 
        Background="#333333" Foreground="White" BorderThickness="0" 
        Cursor="Hand" Click="BtnAbrirCreador_Click" Margin="0,0,0,10"/>
                                <Button Content="Aplicar Skin" Width="120" Height="30" Background="{DynamicResource ColorBtnCerrar}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAplicarSkin_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ecualizador">
                        <Grid Background="{DynamicResource ColorFondoSecundario}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PREAMP &amp; 10-BAND EQ" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Margin="5,0,15,0">
                                    <Slider x:Name="EQ_Pre" ValueChanged="EQ_Pre_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="PRE" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_31" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="31" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_62" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="62" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_125" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="125" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_250" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="250" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_500" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="500" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_1k" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="1k" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_2k" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="2k" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_4k" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="4k" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_8k" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="8k" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5,0">
                                    <Slider x:Name="EQ_16k" ValueChanged="EqBand_ValueChanged" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" Cursor="Hand" TickPlacement="BottomRight" TickFrequency="3"/>
                                    <TextBlock Text="16k" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                                <Button Content="Rock" Width="50" Height="20" Background="#333333" Foreground="White" BorderThickness="0" Margin="5,0" Click="BtnEqRock_Click"/>
                                <Button Content="Pop" Width="50" Height="20" Background="#333333" Foreground="White" BorderThickness="0" Margin="5,0" Click="BtnEqPop_Click"/>
                                <Button Content="Flat" Width="50" Height="20" Background="#333333" Foreground="White" BorderThickness="0" Margin="5,0" Click="BtnEqFlat_Click"/>
                                <Button Content="Guardar" Width="50" Height="20" Background="#2FD21f" Foreground="White" BorderThickness="0" Margin="5,0" Click="BtnEqGuardar_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="1" Background="{DynamicResource ColorFondoPrincipal}" BorderBrush="{DynamicResource ColorBtnCerrar}" BorderThickness="0,1,0,1" Grid.ColumnSpan="2">
                    <TextBlock x:Name="Reproduciendo" Text="[Placeholder titulo]" Foreground="{DynamicResource ColorAcentoTexto}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Border>
                <Grid Grid.Row="2" Background="{DynamicResource ColorControles}" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnShuffle" Width="30" Height="30" Margin="5" Cursor="Hand" Click="BtnShuffle_Click" Background="Transparent" BorderThickness="0" ToolTip="Shuffle: Desactivado">
                            <Rectangle x:Name="IconoShuffle" Width="18" Height="18" Fill="{DynamicResource ColorLetras}" Opacity="0.4">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="🔀" Foreground="Black" Background="Transparent"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <Button Content="⏮" FontSize="16" Width="40" Height="30" Margin="5" Cursor="Hand" Click="BtnAnterior_Click"/>
                        <Button x:Name="BtnPlayPause" Content="▶" FontSize="20" Width="50" Height="40" Margin="5" Click="BtnPlayPause_Click" Cursor="Hand"/>
                        <Button Content="⏭" FontSize="16" Width="40" Height="30" Margin="5" Cursor="Hand" Click="BtnSiguiente_Click"/>
                        <Button x:Name="BtnLoop" Width="30" Height="30" Margin="5" Cursor="Hand" Click="BtnLoop_Click" Background="Transparent" BorderThickness="0" ToolTip="Loop: Desactivado">
                            <Rectangle x:Name="IconoLoop" Width="18" Height="18" Fill="{DynamicResource ColorLetras}" Opacity="0.4">
                                <Rectangle.OpacityMask>
                                    <ImageBrush x:Name="BrushLoop" ImageSource="/assets/imagenes/loop.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <ToggleButton x:Name="BtnVolumen" Width="50" Height="30" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔊" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▾" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnVolumen}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnVolumen}" Placement="Top" VerticalOffset="-5">
                            <Border Background="#2b2b2b" BorderBrush="#555555" BorderThickness="1" CornerRadius="5" Padding="10,15,10,15">
                                <Slider x:Name="SliderVolumen" Orientation="Vertical" Height="100" Minimum="0" Maximum="1" Value="0.10" Cursor="Hand" ValueChanged="SliderVolumen_ValueChanged"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="15" Height="15" Margin="0,0,5,5" Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" MouseMove="ResizeGrip_MouseMove">
            <Path Data="M 10,15 L 15,10 M 5,15 L 15,5" Stroke="Gray" StrokeThickness="2" />
        </Border>
    </Grid>
</Window>