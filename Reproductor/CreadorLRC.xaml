<Window x:Class="Reproductor.CreadorLRC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creador de LRC Pro" Height="580" Width="900" 
        Background="{DynamicResource ColorFondoPrincipal}" 
        Foreground="{DynamicResource ColorLetras}" 
        FontFamily="{DynamicResource FuentePrincipal}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Controles Superiores -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <ComboBox x:Name="ComboCanciones" Width="200" Margin="0,0,10,0" SelectionChanged="ComboCanciones_SelectionChanged" Background="{DynamicResource ColorFondoSecundario}" Foreground="Black"/>

            <Button x:Name="BtnPlay" Content="▶ Play" Width="70" Height="25" Background="{DynamicResource ColorControles}" Foreground="{DynamicResource ColorLetras}" BorderThickness="0" Click="BtnPlay_Click" Cursor="Hand"/>

            <TextBlock x:Name="TxtTiempo" Text="00:00.00" VerticalAlignment="Center" Margin="10,0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorAcentoTexto}"/>

            <TextBlock Text="Velocidad:" VerticalAlignment="Center" Foreground="{DynamicResource ColorLetras}" Opacity="0.7" Margin="5,0,5,0"/>
            <Slider x:Name="SliderVelocidad" Width="80" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderVelocidad_ValueChanged" Cursor="Hand"/>
            <TextBlock x:Name="TxtVelocidad" Text="1.0x" VerticalAlignment="Center" Foreground="{DynamicResource ColorLetras}" Opacity="0.7" Margin="5,0,15,0"/>

            <!-- Botón Toggle de Modo Enhanced -->
            <ToggleButton x:Name="ToggleEnhanced" Content="Modo Karaoke (Palabras)" Width="150" Height="25" Background="{DynamicResource ColorBarraSuperior}" Foreground="{DynamicResource ColorLetras}" BorderThickness="0" Cursor="Hand" Click="ToggleEnhanced_Click"/>

            <Button x:Name="BtnGuardar" Content="💾 Guardar .LRC" Width="110" Height="25" Background="#2FD21f" Foreground="White" BorderThickness="0" Click="BtnGuardar_Click" Cursor="Hand" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Fila de Información y Atajos -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Atajos: [Espacio] Marcar | [Retroceso] Deshacer | [←][→] +/- 5s" Foreground="{DynamicResource ColorLetras}" Opacity="0.6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="SIGUIENTE PALABRA:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtSiguientePalabra" Text="-" Foreground="{DynamicResource ColorAcentoTexto}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Editor Principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtLetrasCrudas" Grid.Column="0" Background="{DynamicResource ColorFondoSecundario}" Foreground="{DynamicResource ColorLetras}" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" FontFamily="{DynamicResource FuenteLetra}" Text="1. Pega tu letra aquí...&#x0a;2. Presiona 'Traspasar'"/>

            <Button Grid.Column="1" Content="Tras-&#x0a;pasar&#x0a; ➡️" Background="{DynamicResource ColorBarraSuperior}" Foreground="{DynamicResource ColorLetras}" BorderThickness="0" Cursor="Hand" Margin="5,0" Click="BtnCargarLetras_Click"/>

            <ListView x:Name="ListaLRC" Grid.Column="2" Background="{DynamicResource ColorFondoSecundario}" Foreground="{DynamicResource ColorLetras}" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListaLRC_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tiempo" Width="80" DisplayMemberBinding="{Binding TiempoStr}"/>
                        <GridViewColumn Header="Sincronización en Vivo" Width="360" DisplayMemberBinding="{Binding TextoSincronizado}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource ColorLetras}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource FuenteLetra}"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="Opacity" Value="0.6"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ColorControles}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorKaraoke}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Window>