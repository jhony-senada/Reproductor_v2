<Window x:Class="Reproductor.CreadorSkins"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creador de Skins" Height="550" Width="350" 
        Background="#111111" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CREADOR DE SKINS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Nombre del Tema:" Foreground="Gray" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtNombreSkin" Background="#222" Foreground="White" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Color Fondo Principal:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtFondoPrin" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="Black"/>

                <TextBlock Text="Color Fondo Secundario:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtFondoSec" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#111111"/>

                <TextBlock Text="Color Barra Superior:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtBarraSup" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#2b2b2b"/>

                <TextBlock Text="Color Controles (Fondo Inferior):" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtControles" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#222222"/>

                <TextBlock Text="Color Letras Generales:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtLetras" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="White"/>

                <TextBlock Text="Color Acento (Títulos):" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtAcento" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="Red"/>

                <TextBlock Text="Color Barras de Fuego:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtBarras" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#E65E39"/>

                <TextBlock Text="Color Osciloscopio Laser:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtOscilo" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#39FF14"/>

                <TextBlock Text="Color Karaoke:" Foreground="Gray" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtKaraoke" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="#FFD700"/>

                <TextBlock Text="Fuente Principal:" Foreground="Gray" Margin="0,10,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFuentePrin" Grid.Column="0" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="Segoe UI"/>
                    <Button x:Name="BtnBuscarFuentePrin" Grid.Column="1" Content="📁" Width="30" Background="#444" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0" Click="BtnBuscarFuentePrin_Click"/>
                </Grid>

                <TextBlock Text="Fuente Letras Canción:" Foreground="Gray" Margin="0,10,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFuenteLetra" Grid.Column="0" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Text="Consolas"/>
                    <Button x:Name="BtnBuscarFuenteLetra" Grid.Column="1" Content="📁" Width="30" Background="#444" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0" Click="BtnBuscarFuenteLetra_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="💾 Guardar Skin" Height="35" Margin="0,15,0,0" 
                Background="#2FD21f" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                Cursor="Hand" Click="BtnGuardar_Click"/>
    </Grid>
</Window>